# Pinned toolchain versions for the Auditor Docker image (M1.1).
# Keep in sync with ARG defaults in docker/Dockerfile.

# Base runtime
PYTHON_IMAGE=python:3.12-slim-bookworm
PYTHON_VERSION=3.12

# Foundry (forge, cast, anvil, chisel) — GitHub release tag
# https://github.com/foundry-rs/foundry/releases
FOUNDRY_VERSION=v1.7.1

# Slither static analyzer (PyPI)
# https://pypi.org/project/slither-analyzer/
SLITHER_VERSION=0.11.6

# solc-select (PyPI) + default solc for standalone paths
SOLC_SELECT_VERSION=1.2.0
# Default solc for solc-select (standalone Slither / non-Foundry paths).
# Foundry still manages its own solc via `forge` (svm cache under ~/.svm).
SOLC_VERSION=0.8.28
