# Copy to .env for local secrets (never commit .env).
# Compose: docker compose --env-file .env run --rm auditor versions
# Script:  set -a && source .env && set +a && ./scripts/run-local.sh

# LLM (optional — static analysis works without these)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides (placeholders for later phases)
# AUDIT_LLM_MODEL=
# AUDIT_LLM_PROVIDER=

# Engine
AUDIT_TIMEOUT_SECONDS=300
AUDIT_TERM_GRACE_SECONDS=2
AUDIT_JOB_ROOT=/work/jobs
AUDIT_NETWORK_POLICY=deny
AUDIT_CPU_LIMIT=2
AUDIT_MAX_PIDS=256
AUDIT_PRINT_VERSIONS=0

# Dependencies (strict = offline vendor only; see docs/dependencies.md)
AUDIT_DEPENDENCY_MODE=strict
AUDIT_AUTO_VENDOR=true
# AUDIT_AUTO_VENDOR_PACKS=forge-std,openzeppelin-contracts
# AUDIT_VENDOR_ROOT=

# Ingest limits (optional)
# AUDIT_MAX_SOURCE_BYTES=2000000
# AUDIT_MAX_SOURCE_FILES=200
# AUDIT_GIST_FETCH_TIMEOUT_SECONDS=30
