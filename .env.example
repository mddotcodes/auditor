# Copy to .env for local secrets (never commit .env).
# Load: set -a && source .env && set +a

# ── LLM keys (optional — static analysis works without these) ──────────────
# Provider is chosen by which key is set (priority: OpenRouter → OpenAI → Anthropic).
# AUDIT_LLM_PROVIDER is not used.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Models ─────────────────────────────────────────────────────────────────
# Single-model mode (AUDIT_LLM_DUAL=false or unset):
#   one model does plan + write + compile repair.
AUDIT_LLM_MODEL=deepseek/deepseek-v4-flash

# Dual plan→code (not consensus): strong planner, cheaper implementer.
# Plan model: decide what to test. Code model: write/repair Foundry .t.sol.
AUDIT_LLM_DUAL=true
AUDIT_LLM_PLAN_MODEL=deepseek/deepseek-v4-pro
AUDIT_LLM_CODE_MODEL=deepseek/deepseek-v4-flash
# AUDIT_LLM_REPAIR_MODEL=   # omit → same as CODE

# ── Engine ─────────────────────────────────────────────────────────────────
AUDIT_TIMEOUT_SECONDS=300
AUDIT_TERM_GRACE_SECONDS=2
AUDIT_JOB_ROOT=/work/jobs
AUDIT_NETWORK_POLICY=deny
AUDIT_CPU_LIMIT=2
AUDIT_MAX_PIDS=256
AUDIT_PRINT_VERSIONS=0
# AUDIT_PROFILE=static   # CLI defaults to static; use default for LLM tests

# Dependencies (strict = offline vendor only; see docs/dependencies.md)
AUDIT_DEPENDENCY_MODE=strict
AUDIT_AUTO_VENDOR=true
# AUDIT_AUTO_VENDOR_PACKS=forge-std,openzeppelin-contracts
# AUDIT_VENDOR_ROOT=

# Ingest limits (optional)
# AUDIT_MAX_SOURCE_BYTES=2000000
# AUDIT_MAX_SOURCE_FILES=200
# AUDIT_GIST_FETCH_TIMEOUT_SECONDS=30

# HTTP API (auditor-serve / docker serve)
# AUDIT_HOST=0.0.0.0
# AUDIT_PORT=8080
# AUDIT_API_TOKEN=
# AUDIT_MAX_INFLIGHT_JOBS=2
# AUDIT_WORKER_THREADS=2
# AUDIT_EVENT_BUFFER_SIZE=2000
